From d8f70b8e11b62bdaf5bd3cdea129b5ad2526e1cd Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:00:51 +0000
Subject: [PATCH 45/61] NNS.diff: solve for h to tol and converge on the B
 bracket

Each iteration solved for the inferred h with uniroot() at its default
tolerance (about 1.2e-4) and declared convergence when |h| < tol
(1e-10). The stopping point of uniroot therefore decided both the
derivative accuracy and the 'converged' flag: log'(5), tanh'(0.5) and
(x^4 - 3x)'(-2) were reported converged with errors of 4e-7 to 6e-4.

Solve with uniroot(tol = tol / 10), and declare convergence when the
bisection bracket on the intercept B is narrower than
tol * max(1, |B|) (|h| < tol is unreachable in double precision once h
is accurate, because (f.x - f(point - h)) / h loses all digits).

Before -> after (DERIVATIVE error, iterations, converged):
  sin'(1)          -8.4e-08 29 1 ->  5.0e-10 30 1
  (x^3)'(2)         8.6e-06 29 1 ->  4.4e-08 32 1
  log'(5)          -3.8e-07 28 1 ->  2.6e-10 30 1
  tanh'(0.5)       -1.0e-05 31 1 -> -8.8e-10 28 1
  (x^4-3x)'(-2)     5.7e-04 30 1 ->  5.1e-08 32 1
Immediate exits (linear f, |x| at -1, point = 0) are unchanged.
---
 R/Numerical_Differentiation.R | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/R/Numerical_Differentiation.R b/R/Numerical_Differentiation.R
index 2d7a35a..f10a3fb 100644
--- a/R/Numerical_Differentiation.R
+++ b/R/Numerical_Differentiation.R
@@ -163,8 +163,11 @@ NNS.diff <- function(f, point, h = abs(point) * 0.1 + 0.01, tol = 1e-10, max.ite
     
     new.f <- function(x) -f.x + ((f.x - f(point - x)) / x) * point + new.B
     
+    # Solve for h to the same tolerance used in the convergence test below;
+    # uniroot's default tol (~1.2e-4) made |inferred.h| < tol a test of
+    # uniroot's stopping point rather than of the root.
     inferred.h <- tryCatch(
-      uniroot(new.f, c(-2 * h, 2 * h), extendInt = "yes")$root,
+      uniroot(new.f, c(-2 * h, 2 * h), extendInt = "yes", tol = tol / 10)$root,
       error = function(e) NA_real_
     )
     
@@ -206,6 +209,15 @@ NNS.diff <- function(f, point, h = abs(point) * 0.1 + 0.01, tol = 1e-10, max.ite
     }
     
     new.B <- mean(c(lower.B, upper.B))
+    
+    # Converged once the bisection bracket on B is tight: inferred.h itself
+    # cannot reach |h| < tol in double precision ((f.x - f(point - h)) / h
+    # loses all digits as h -> 0).
+    if(abs(upper.B - lower.B) <= tol * max(1, abs(new.B))) {
+      converged <- TRUE
+      termination.code <- 0L
+      break
+    }
     i <- i + 1L
   }
   
