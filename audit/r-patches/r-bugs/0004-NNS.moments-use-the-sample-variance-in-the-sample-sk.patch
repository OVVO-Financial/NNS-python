From 1be7306dc4d336b3978322592a3cbc2d4073beaf Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:24:28 +0000
Subject: [PATCH 04/61] NNS.moments: use the sample variance in the sample
 skewness

With population = FALSE the skewness was
n/((n-1)(n-2)) * n*mean(z^3) / v^(3/2) with v = mean(z^2), the population
variance. The adjusted Fisher-Pearson estimator G1 (Excel SKEW,
scipy skew(bias = FALSE)) divides by s^3 with s the (n-1) sample sd, which
the kurtosis branch of the same function already does. The result was
inflated by (n/(n-1))^1.5.

Before -> after (population = FALSE):
  x = c(1,2,4,8,16)        1.852184 -> 1.325315 (scipy: 1.325315)
  rexp(4000), seed 1       2.014439 -> 2.013683 (G1:    2.013683)

Sample skewness changes (by 40% at n = 5, 0.04% at n = 4000); the
population statistics, mean, variance and kurtosis are unchanged.
---
 R/Partial_Moments.R | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/R/Partial_Moments.R b/R/Partial_Moments.R
index 7390af5..f3806d7 100644
--- a/R/Partial_Moments.R
+++ b/R/Partial_Moments.R
@@ -464,8 +464,10 @@ NNS.moments <- function(x, population = TRUE) {
     skewness <- skew_base / variance^(3 / 2)
     kurtosis <- (kurt_base / variance^2) - 3
   } else {
+    # Adjusted Fisher-Pearson G1: n/((n-1)(n-2)) * sum(z^3) / s^3, with s the
+    # sample (n-1) standard deviation, as in the kurtosis branch below.
     skewness <- (n / ((n - 1) * (n - 2))) *
-      ((n * skew_base) / variance^(3 / 2))
+      ((n * skew_base) / (variance * (n / (n - 1)))^(3 / 2))
     
     kurtosis <- ((n * (n + 1)) / ((n - 1) * (n - 2) * (n - 3))) *
       ((n * kurt_base) / (variance * (n / (n - 1)))^2) -
-- 
2.43.0

