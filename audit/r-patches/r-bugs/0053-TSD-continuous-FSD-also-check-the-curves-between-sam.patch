-  x.tsd.y <- any(LPM_x_sort > LPM_y_sort)
-  y.tsd.x <- any(LPM_y_sort > LPM_x_sort)
 
 
   if(plot){
@@ -51,9 +49,15 @@ NNS.TSD <- function(x, y, plot = TRUE){
