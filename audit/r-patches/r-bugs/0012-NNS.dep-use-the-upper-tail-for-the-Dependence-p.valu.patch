From 4efc5b770d816f00b583372e1c2e61fc365a551a Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:32:49 +0000
Subject: [PATCH 12/61] NNS.dep: use the upper tail for the Dependence p.value

The Dependence p.value was min(LPM(0, obs, null), UPM(0, obs, null)): the
smaller of the two one-sided tail frequencies, without a +1 correction.
Dependence is a non-negative magnitude, so an observed value far *below*
the permutation null also produced a small p-value, the minimum of two
tails doubled the size, and p = 0 was possible. Use the upper tail
(1 + #{null >= obs}) / (1 + B).

Evidence (n = 100, B = 100 permutations):
  100 independent normal pairs (seed 5): P(p < 0.05) 0.13 -> 0.08,
    P(p <= 0.10) 0.22 -> 0.15, min p 0 -> 0.0099
  independent example (seed 11): p 0.49 -> 0.495
  y = x + N(0, 0.5^2) (seed 6): p 0.01 -> 0.0198

The Dependence p.value changes; Correlation p.value, the CIs and the
point estimates are unchanged.
---
 R/Dependence.R | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/R/Dependence.R b/R/Dependence.R
index d3c6915..4935e7f 100644
--- a/R/Dependence.R
+++ b/R/Dependence.R
@@ -118,8 +118,10 @@ NNS.dep <- function(x,
                                     UPM(0, cors[2L], cors[-c(1L, 2L)])),
         "Correlation 95% CIs" = c(cor_lower_CI, cor_upper_CI),
         "Dependence"          = as.numeric(deps[2L]),
-        "Dependence p.value"  = min(LPM(0, deps[2L], deps[-c(1L, 2L)]),
-                                    UPM(0, deps[2L], deps[-c(1L, 2L)])),
+        # Dependence is a non-negative magnitude: only large values are evidence
+        # against independence, so use the upper tail (with the +1 correction).
+        "Dependence p.value"  = (1 + sum(deps[-c(1L, 2L)] >= deps[2L])) /
+                                (1 + length(deps[-c(1L, 2L)])),
         "Dependence 95% CIs"  = c(dep_lower_CI, dep_upper_CI)
       ))
     }
