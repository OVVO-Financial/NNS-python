From 1f1490e00366f95887af4254955ced56c18b8449 Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:30:40 +0000
Subject: [PATCH 09/61] NNS.dep: keep the sign for fully discordant partition
 cells

copula_signed() returned an unsigned +1 both when every point of a cell
was concordant and when every point was discordant, skipping the
slope-sign multiplication. With y = -x every X-only cell is fully
discordant, so the signed Correlation came out as +1.

Return -1 for a fully discordant cell.

Before -> after (Correlation / Dependence):
  NNS.dep(x, -x), x ~ N(0,1), n=1000      1 / 1      -> -1 / 1
  NNS.dep(1:100, -(1:100))                0.370/0.990 -> -0.990/0.990
  NNS.dep(c(1,2), c(2,1))                 1 / 1      -> -1 / 1
  NNS.dep(x, -x, asym = TRUE)             1 / 1      -> -1 / 1
  NNS.dep(cbind(x, -x, x^2))$Correlation[1,2]  1 -> -1, [1,3] 0.180 -> 0.046
Unchanged: dep(x,x) 1/1, dep(x,-x^3) -0.964/0.974, dep(x,x+e)
0.427/0.427, circle, step and independent cases.

Results change only for inputs with at least one fully discordant cell;
Dependence (the absolute value) is unaffected there.
---
 src/NNS_dep.cpp | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/src/NNS_dep.cpp b/src/NNS_dep.cpp
index 66a92b0..6b4155a 100644
--- a/src/NNS_dep.cpp
+++ b/src/NNS_dep.cpp
@@ -86,7 +86,11 @@ static double copula_signed(const std::vector<double>& xv,
   // for many n (e.g. 49 * (1/49) != 1).
   double d0_concordant = d0_cupm + d0_clpm;
   double d0_Co = d0_concordant * inv_n;
-  if (d0_concordant == static_cast<double>(n) || d0_concordant == 0.0) return 1.0;
+  // Every point concordant: perfect positive dependence. Every point
+  // discordant: perfect negative dependence (this branch used to return +1,
+  // losing the sign, so NNS.dep(x, -x) reported Correlation = +1).
+  if (d0_concordant == static_cast<double>(n)) return 1.0;
+  if (d0_concordant == 0.0) return -1.0;
   
   double c1_total = c1_cupm + c1_clpm + c1_dpm;
   double co_d1 = c1_total > 0.0 ? (c1_cupm + c1_clpm) / c1_total : 0.0;
