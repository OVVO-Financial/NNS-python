From 7e170c9b94172e5c24a6f15e70764ae9e48e560c Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:48:37 +0000
Subject: [PATCH 32/61] NNS.stack/NNS.boost: sample within single-member
 classes when balancing

The balancing helpers drew each class with sample(g, k). When a class
has exactly one member in the fitting split, g is a single index and
sample(g, k) samples from 1:g instead: the rare class is replaced by rows
of other classes, which defeats balance = TRUE in exactly the rare-class
case it exists for (groups {1,2,3}/{4,5,6}/{7}: the 'class 3' picks were
rows 1 / 3, 6, 2). Index with g[sample.int(length(g), k, replace)],
which is the identical draw whenever length(g) > 1.

Before -> after (3 classes 29/29/2, balance = TRUE, method = 1, seed = 1):
  NNS.stack OOF accuracy 0.867 -> 0.883, n.best 3 -> 5,
  probability.threshold 0.61 -> 0.20
iris balance = TRUE (seed 1) is unchanged (OBJfn.dim.red 0.96, weights
0.55/0.45), as are all splits without a single-member class.
---
 R/Boost.R | 6 ++++--
 R/Stack.R | 7 +++++--
 2 files changed, 9 insertions(+), 4 deletions(-)

diff --git a/R/Boost.R b/R/Boost.R
index 77f17f0..39f7ecd 100644
--- a/R/Boost.R
+++ b/R/Boost.R
@@ -561,10 +561,12 @@ NNS.boost <- function(IVs.train,
     smallest <- min(lengths(groups))
     largest <- max(lengths(groups))
     
+    # g[sample.int(...)]: sample(g, k) on a length-one group g samples from
+    # 1:g and drops that class. Same draw as sample(g, k) when length(g) > 1.
     down_idx <- unlist(lapply(groups, function(g)
-      sample(g, smallest, replace = FALSE)), use.names = FALSE)
+      g[sample.int(length(g), smallest, replace = FALSE)]), use.names = FALSE)
     up_idx <- unlist(lapply(groups, function(g)
-      sample(g, largest, replace = TRUE)), use.names = FALSE)
+      g[sample.int(length(g), largest, replace = TRUE)]), use.names = FALSE)
     
     idx <- sort(c(down_idx, up_idx))
     list(x = train_x[idx, , drop = FALSE], y = train_y[idx])
diff --git a/R/Stack.R b/R/Stack.R
index f371b29..26159ae 100644
--- a/R/Stack.R
+++ b/R/Stack.R
@@ -597,11 +597,14 @@ NNS.stack <- function(IVs.train,
     }
     smallest <- min(lengths(groups))
     largest <- max(lengths(groups))
+    # Index into each group with sample.int(): sample(g, k) on a length-one
+    # group g samples from 1:g instead, dropping that (rare) class. For
+    # length(g) > 1 this is the same draw as sample(g, k, replace).
     down_idx <- unlist(lapply(groups, function(g) {
-      sample(g, smallest, replace = FALSE)
+      g[sample.int(length(g), smallest, replace = FALSE)]
     }), use.names = FALSE)
     up_idx <- unlist(lapply(groups, function(g) {
-      sample(g, largest, replace = TRUE)
+      g[sample.int(length(g), largest, replace = TRUE)]
     }), use.names = FALSE)
     sample(c(down_idx, up_idx), replace = FALSE)
   }
