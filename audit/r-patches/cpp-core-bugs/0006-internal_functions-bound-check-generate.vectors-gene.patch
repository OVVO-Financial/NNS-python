From 7e9cee8281946296e572959e74a91bd3df210c6e Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:42:28 +0000
Subject: [PATCH 6/7] internal_functions: bound-check generate.vectors /
 generate.lin.vectors

generate.vectors() takes positions start, start + lag, ... <= n with
start = n %% lag + 1. For lag > n, start is n + 1 and the component is
empty, but the length (n - start) / lag + 1 truncates -1 / lag to 0,
gives m = 1 and reads x[n], one past the end:

  NNS:::generate.vectors(c(1, 2, 3), 7L)   # 4.9e-311, 2.8e-313, ...
                                            # (changes on every run)
  NNS.ARMA(x6, h = 2, seasonal.factor = 9, method = "lin")  # NA NA

generate.lin.vectors() has the same start > n case and uses l as a
modulus, so NNS:::generate.lin.vectors(1:4, 0L) dies with "Floating
point exception" (exit code 136), taking the R session with it.

Return an empty component when start > n, stop() for l < 1 or h < 0
in generate.lin.vectors, and stop() when len exceeds length(x) in
generate.vectors. generate.vectors(c(1, 2, 3), 7L) now returns empty
components; NNS.ARMA in the example returns NaN NaN deterministically
(it still does not validate seasonal.factor > length(variable) itself).
In-range results are unchanged.
---
 src/internal_functions.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/src/internal_functions.cpp b/src/internal_functions.cpp
index 3e09439..8545b9d 100644
--- a/src/internal_functions.cpp
+++ b/src/internal_functions.cpp
@@ -182,6 +182,7 @@ List generate_vectors(NumericVector x, IntegerVector l, int len = -1) {
   // recursive forecast steps without re-allocating or copying a growing
   // vector each step.  len < 0 (default) preserves the original behaviour of
   // using the full length of 'x'.
+  if (len > x.size()) stop("'len' must not exceed length(x)");
   int n = (len < 0) ? x.size() : len;
   List comp_series(l.size()), comp_index(l.size());
   for (int t = 0; t < l.size(); ++t) {
@@ -191,8 +192,11 @@ List generate_vectors(NumericVector x, IntegerVector l, int len = -1) {
       comp_index[t] = IntegerVector(0);
       continue;
     }
+    // Positions start, start + lag, ... <= n.  For lag > n, start = n + 1 and
+    // the component is empty (the old m = (n - start) / lag + 1 truncated
+    // -1 / lag to 0, gave m = 1 and read x[n], one past the end).
     int start = (n % lag) + 1;
-    int m = ((n - start) / lag) + 1;
+    int m = (start > n) ? 0 : ((n - start) / lag) + 1;
     
     NumericVector s(no_init(m));
     IntegerVector idx(no_init(m));
@@ -227,13 +231,17 @@ static List create_recycled_list_num(const NumericVector& values, int list_lengt
 
 // [[Rcpp::export(name = "generate.lin.vectors")]]
 List generate_lin_vectors(NumericVector x, int l, int h = 1) {
+  // l is used as a modulus below: l = 0 raised SIGFPE and killed the session.
+  if (l < 1) stop("'l' must be a positive integer");
+  if (h < 0) stop("'h' must be a non-negative integer");
   int n = x.size();
   int max_fcast = std::min(h, l);
   
   List comp_series(max_fcast), comp_index(max_fcast);
   for (int i = 1; i <= max_fcast; ++i) {
     int start = ((n + i - 1) % l) + 1;
-    int m = ((n - start) / l) + 1;
+    // start > n (l > n) means an empty component; see generate_vectors.
+    int m = (start > n) ? 0 : ((n - start) / l) + 1;
     NumericVector s(no_init(m));
     IntegerVector idx(no_init(m));
     int pos = start;
