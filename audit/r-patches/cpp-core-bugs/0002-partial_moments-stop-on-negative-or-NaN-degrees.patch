From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:32:14 +0000
Subject: [PATCH 2/7] partial_moments: stop() on negative or NaN degrees

The partial moment entry points accepted negative degrees and silently
computed something else. repeatMultiplication(value, n) returns 1 for
n < 0, so the integer fast path evaluates a negative degree as the
degree-0 count:

  LPM(-1, 0, c(-2, 1))                 = 0.5   (power rule: 0.25)
  Co.LPM(-1, c(-2, 1), c(-2, 1), 0, 0) = 1     (0^-1 counted as 1)

A NaN degree reached static_cast<int>(NaN), which is undefined
behaviour. NNS-python already rejects negative degrees.

Add nns_check_degree() and call it at the top of LPM_RCPP, UPM_RCPP,
LPM.ratio, UPM.ratio, CoLPM_RCPP, CoUPM_RCPP, D.LPM, D.UPM,
PMMatrix_RCPP, PMMatrix_CPv, Co.LPM_nD/Co.UPM_nD/DPM_nD and
CoLPM_nD_batch_RCPP, before any parallel work starts.

This changes R behaviour only for negative or NaN degrees, which now
raise "'degree' must be a non-negative number" instead of returning a
wrong number.
---
 src/partial_moments.cpp      |  3 +++
 src/partial_moments.h        | 11 +++++++++++
 src/partial_moments_rcpp.cpp | 17 +++++++++++++++++
 3 files changed, 31 insertions(+)

diff --git a/src/partial_moments.cpp b/src/partial_moments.cpp
index 5c3a50c..ff32f06 100644
--- a/src/partial_moments.cpp
+++ b/src/partial_moments.cpp
@@ -448,6 +448,7 @@ NumericVector CoLPM_nD_batch_RCPP(const NumericMatrix& data,
                                   const NumericMatrix& targets,
                                   double degree = 0.0,
                                   bool norm = true) {
+  nns_check_degree(degree, "degree");
   if (data.ncol() != targets.ncol()) {
     stop("`targets` must have the same number of columns as `data`");
   }
@@ -927,6 +928,8 @@ List PMMatrix_CPv(
     const bool &pop_adj,
     const bool &norm
 ) {
+  nns_check_degree(LPM_degree, "LPM_degree");
+  nns_check_degree(UPM_degree, "UPM_degree");
   size_t variable_cols = variable.cols();
   size_t target_length = target.size();
   if(variable_cols != target_length){
diff --git a/src/partial_moments.h b/src/partial_moments.h
index 020502d..13b1cbf 100644
--- a/src/partial_moments.h
+++ b/src/partial_moments.h
@@ -28,6 +28,17 @@ double UPM_C(const double &degree,
              const double &target,
              const RcppParallel::RVector<double> &variable);
 
+// Partial moments are defined for degree >= 0. A negative degree used to be
+// evaluated silently (repeat-multiplication with n < 0 returns 1, so the
+// integer fast path returned the degree-0 count), and NaN reached
+// static_cast<int>(NaN). Called from the R-facing wrappers before any
+// parallel work starts.
+inline void nns_check_degree(const double degree, const char *name) {
+  if (!(degree >= 0.0)) {
+    Rcpp::stop("'%s' must be a non-negative number", name);
+  }
+}
+
 namespace nns_pm_detail {
 
 // Keep very large integer degrees on the legacy full-scan path. This prevents
diff --git a/src/partial_moments_rcpp.cpp b/src/partial_moments_rcpp.cpp
index 8b58804..5db2b99 100644
--- a/src/partial_moments_rcpp.cpp
+++ b/src/partial_moments_rcpp.cpp
@@ -67,6 +67,7 @@ double CoLPM_nD_RCPP(const NumericMatrix &data,
                      const NumericVector &target,
                      const double &degree,
                      const bool &norm ) {
+  nns_check_degree(degree, "degree");
   return clpm_nD_cpp(data, target, degree, norm);
 }
 
@@ -75,6 +76,7 @@ double CoUPM_nD_RCPP(const NumericMatrix &data,
                      const NumericVector &target,
                      const double &degree,
                      const bool &norm ) {
+  nns_check_degree(degree, "degree");
   return cupm_nD_cpp(data, target, degree, norm);
 }
 
@@ -83,6 +85,7 @@ double DPM_nD_RCPP(const NumericMatrix &data,
                      const NumericVector &target,
                      const double &degree,
                      const bool &norm ) {
+  nns_check_degree(degree, "degree");
   return dpm_nD_cpp(data, target, degree, norm);
 } 
 
@@ -93,6 +96,7 @@ NumericVector LPM_RCPP(const double &degree,
                        const RObject &target,
                        const RObject &variable,
                        const bool &excess_ret) {
+  nns_check_degree(degree, "degree");
   NumericVector variable_vec = as<NumericVector>(clone(variable));
   NumericVector target_vec;
   if (is_supplied_target(target)) {
@@ -130,6 +134,7 @@ NumericVector UPM_RCPP(const double &degree,
                        const RObject &target,
                        const RObject &variable,
                        const bool &excess_ret) {
+  nns_check_degree(degree, "degree");
   NumericVector variable_vec = as<NumericVector>(clone(variable));
   NumericVector target_vec;
   if (is_supplied_target(target)) {
@@ -187,6 +192,7 @@ NumericVector UPM_RCPP(const double &degree,
 //' @export
 // [[Rcpp::export("LPM.ratio", rng = false)]]
  NumericVector LPM_ratio_RCPP(const double &degree, const RObject &target, const RObject &variable) {
+   nns_check_degree(degree, "degree");
    NumericVector target_vec, variable_vec;
    if (is<NumericVector>(variable))
      variable_vec=as<NumericVector>(variable);
@@ -233,6 +239,7 @@ NumericVector UPM_RCPP(const double &degree,
 //' @export
 // [[Rcpp::export("UPM.ratio", rng = false)]]
  NumericVector UPM_ratio_RCPP(const double &degree, const RObject &target, const RObject &variable) {
+   nns_check_degree(degree, "degree");
    NumericVector target_vec, variable_vec;
    if (is<NumericVector>(variable))
      variable_vec=as<NumericVector>(variable);
@@ -263,6 +270,8 @@ NumericVector CoLPM_RCPP(
      const RObject &target_x, const RObject &target_y,
      const double &degree_y
  ) {
+   nns_check_degree(degree_lpm, "degree_lpm");
+   nns_check_degree(degree_y, "degree_y");
    NumericVector target_x_vec, target_y_vec, x_vec, y_vec;
    if (is<NumericVector>(x))    x_vec=as<NumericVector>(x);
    else if (is<IntegerVector>(x))	x_vec=as<NumericVector>(x);
@@ -302,6 +311,8 @@ NumericVector CoUPM_RCPP(
      const RObject &target_x, const RObject &target_y,
      const double &degree_y
  ) {
+   nns_check_degree(degree_upm, "degree_upm");
+   nns_check_degree(degree_y, "degree_y");
    NumericVector target_x_vec, target_y_vec, x_vec, y_vec;
    if (is<NumericVector>(x))    x_vec=as<NumericVector>(x);
    else if (is<IntegerVector>(x))	x_vec=as<NumericVector>(x);
@@ -359,6 +370,8 @@ NumericVector CoUPM_RCPP(
      const RObject &x, const RObject &y, 
      const RObject &target_x, const RObject &target_y
  ) {
+   nns_check_degree(degree_lpm, "degree_lpm");
+   nns_check_degree(degree_upm, "degree_upm");
    NumericVector target_x_vec, target_y_vec, x_vec, y_vec;
    if (is<NumericVector>(x))    x_vec=as<NumericVector>(x);
    else if (is<IntegerVector>(x))	x_vec=as<NumericVector>(x);
@@ -416,6 +429,8 @@ NumericVector CoUPM_RCPP(
      const RObject &x, const RObject &y, 
      const RObject &target_x, const RObject &target_y
  ) {
+   nns_check_degree(degree_lpm, "degree_lpm");
+   nns_check_degree(degree_upm, "degree_upm");
    NumericVector target_x_vec, target_y_vec, x_vec, y_vec;
    if (is<NumericVector>(x))    x_vec=as<NumericVector>(x);
    else if (is<IntegerVector>(x))	x_vec=as<NumericVector>(x);
@@ -458,6 +473,8 @@ NumericVector CoUPM_RCPP(
      const bool pop_adj,
      const bool norm
  ) {
+   nns_check_degree(LPM_degree, "LPM_degree");
+   nns_check_degree(UPM_degree, "UPM_degree");
    if(variable.isNULL()){
      Rcpp::stop("variable can't be null");
      return List::create();
