From b635ca924ce811f91c95125ff296dd07747dffcd Mon Sep 17 00:00:00 2001
From: Rasheed <99349713+gitRasheed@users.noreply.github.com>
Date: Sat, 31 Oct 2026 23:38:25 +0000
Subject: [PATCH 3/7] central_tendencies: key discrete NNS.mode on the rounded
 double, not int

NNS.mode(discrete = TRUE) counted frequencies in an
unordered_map<int, int>, converting each rounded value to int. Beyond
the int range that conversion is undefined behaviour; on x86 it gives
INT_MIN:

  NNS.mode(c(3e9, 3e9, 3e9, 1, 2), discrete = TRUE)    # -2147483648
  NNS.mode(c(-5e9, -5e9, -5e9, 1, 2), discrete = TRUE) # -2147483648

(UBSan: "3e+09 is outside the range of representable values of type
'int'"). Volumes, IDs and nanosecond timestamps hit this.

Key the map on the rounded double (folding -0.0 into 0.0) and keep the
tied modes as doubles. The examples now return 3e9 and -5e9. Results
for values inside the int range are unchanged.
---
 src/central_tendencies.cpp | 14 ++++++++------
 1 file changed, 8 insertions(+), 6 deletions(-)

diff --git a/src/central_tendencies.cpp b/src/central_tendencies.cpp
index 58f524d..76f090b 100644
--- a/src/central_tendencies.cpp
+++ b/src/central_tendencies.cpp
@@ -283,24 +283,26 @@ SEXP NNS_mode_cpp(SEXP xSEXP, bool discrete, bool multi) {
       return Rf_ScalarReal(nearest_int_half_up(med));
     }
     
-    // Integerize and count exact frequencies
-    std::unordered_map<int,int> freq; freq.reserve(l * 2u);
-    for (double v : xnum) ++freq[ nearest_int_half_up(v) ];
+    // Integerize and count exact frequencies.  Key on the rounded double: an
+    // int key is undefined behaviour beyond the int range (3e9 became
+    // -2147483648).  "+ 0.0" folds -0.0 (ceil(-0.3)) into the 0 key.
+    std::unordered_map<double,int> freq; freq.reserve(l * 2u);
+    for (double v : xnum) ++freq[ nearest_int_half_up(v) + 0.0 ];
     
     int maxf = 0; for (auto &kv : freq) if (kv.second > maxf) maxf = kv.second;
     
-    std::vector<int> modes_int;
+    std::vector<double> modes_int;
     for (auto &kv : freq) if (kv.second == maxf) modes_int.push_back(kv.first);
     std::sort(modes_int.begin(), modes_int.end());
     
     if (multi) {
       NumericVector out((int)modes_int.size());
-      for (int i = 0; i < (int)modes_int.size(); ++i) out[i] = (double)modes_int[i];
+      for (int i = 0; i < (int)modes_int.size(); ++i) out[i] = modes_int[i];
       return out;            // e.g., 2 3 4 for c(1,2,2,3,3,4,4,5)
     } else {
       // Return the arithmetic mean of all tied modes
       long double sum = 0.0L;
-      for (int m : modes_int) sum += (long double)m;
+      for (double m : modes_int) sum += (long double)m;
       double mean_modes = (modes_int.empty() ? NA_REAL
                              : (double)(sum / (long double)modes_int.size()));
       return Rf_ScalarReal(mean_modes);
